{
  "name": "ecommerce",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/modules/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "@cloudflare/workers-types": "^4.20251213.0",
      "bun-types": "^1.3.12",
      "@orpc/tanstack-query": "^1.14.1",
      "@orpc/server": "^1.14.1",
      "@orpc/client": "^1.14.1",
      "better-auth": "1.6.11",
      "alchemy": "2.0.0-beta.61",
      "wrangler": "^4.8.1",
      "next-themes": "^0.4.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "@effect/platform-bun": "4.0.0-beta.93",
      "@effect/platform-node": "4.0.0-beta.93",
      "@effect/sql-pg": "4.0.0-beta.93",
      "@types/pg": "8.20.0",
      "effect": "4.0.0-beta.93",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "pg": "8.22.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:status": "turbo -F @ecommerce/db-postgres db:status",
    "db:migrate": "turbo -F @ecommerce/db-postgres db:migrate",
    "db:reset-and-seed-development": "turbo -F @ecommerce/db-postgres db:reset-and-seed-development",
    "db:seed-development": "turbo -F @ecommerce/db-postgres db:seed-development",
    "deploy": "turbo -F @ecommerce/infra deploy",
    "destroy": "turbo -F @ecommerce/infra destroy",
    "test": "turbo test",
    "test:integration": "turbo -F @ecommerce/infra test:integration",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@ecommerce/env": "workspace:*",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@ecommerce/config": "workspace:*",
    "@effect/tsgo": "0.16.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "latest",
    "bun-types": "catalog:",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.8.1"
  },
  "packageManager": "bun@1.3.12"
}
