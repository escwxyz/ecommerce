{
  "name": "ecommerce",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/modules/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "@cloudflare/workers-types": "^4.20251213.0",
      "bun-types": "^1.3.12",
      "hono": "^4.11.5",
      "@orpc/contract": "^1.14.1",
      "@orpc/server": "^1.14.1",
      "@orpc/openapi": "^1.14.1",
      "@orpc/tanstack-query": "^1.14.1",
      "@orpc/zod": "^1.14.1",
      "@orpc/client": "^1.14.1",
      "better-auth": "1.6.11",
      "alchemy": "2.0.0-beta.57",
      "wrangler": "^4.8.1",
      "next-themes": "^0.4.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "@effect/platform-bun": ">=4.0.0-beta.84 || >=4.0.0",
      "@effect/platform-node": ">=4.0.0-beta.84 || >=4.0.0",
      "effect": ">=4.0.0-beta.84 || >=4.0.0",
      "kysely": "0.28.17",
      "kysely-d1": "^0.4.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @ecommerce/db-d1 db:push",
    "db:seed": "turbo -F @ecommerce/db-d1 db:seed",
    "db:generate": "turbo -F @ecommerce/db-d1 db:generate",
    "deploy": "turbo -F @ecommerce/infra deploy",
    "destroy": "turbo -F @ecommerce/infra destroy",
    "test": "turbo test",
    "test:integration": "turbo -F @ecommerce/infra test:integration",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@ecommerce/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@ecommerce/config": "workspace:*",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.8.1"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "packageManager": "bun@1.3.12"
}
